<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gitee.apigrab.persistence.mapper.FieldMappingMapper">
    <resultMap id="BaseResultMap" type="com.gitee.apigrab.persistence.entity.FieldMappingEntity">
        <id column="id" property="id"/>
        <result column="task_id" property="taskId"/>
        <result column="source_field" property="sourceField"/>
        <result column="target_field" property="targetField"/>
        <result column="target_type" property="targetType"/>
        <result column="target_length" property="targetLength"/>
        <result column="nullable" property="nullable"/>
        <result column="default_value" property="defaultValue"/>
        <result column="convert_expr" property="convertExpr"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="BaseColumns">
        id, task_id, source_field, target_field, target_type, target_length,
        nullable, default_value, convert_expr, sort_order, create_time
    </sql>

    <select id="selectByTaskId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM APIGRAB_FIELD_MAPPING
        WHERE task_id = #{taskId}
        ORDER BY sort_order ASC
    </select>

    <insert id="batchInsert">
        INSERT INTO APIGRAB_FIELD_MAPPING (task_id, source_field, target_field, target_type,
            target_length, nullable, default_value, convert_expr, sort_order)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.taskId}, #{item.sourceField}, #{item.targetField}, #{item.targetType},
             #{item.targetLength}, #{item.nullable}, #{item.defaultValue}, #{item.convertExpr}, #{item.sortOrder})
        </foreach>
    </insert>

    <delete id="deleteByTaskId">
        DELETE FROM APIGRAB_FIELD_MAPPING WHERE task_id = #{taskId}
    </delete>
</mapper>
