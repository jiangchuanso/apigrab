<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>${project.version}</id>

    <formats>
        <format>tar.gz</format>
    </formats>

    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>apigrab-release-${project.version}</baseDirectory>

    <files>
        <!-- 启动/停止脚本：shell 用 unix 换行并赋予可执行权限 -->
        <file>
            <source>src/main/assembly/bin/startup.sh</source>
            <outputDirectory>bin</outputDirectory>
            <lineEnding>unix</lineEnding>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>src/main/assembly/bin/shutdown.sh</source>
            <outputDirectory>bin</outputDirectory>
            <lineEnding>unix</lineEnding>
            <fileMode>0755</fileMode>
        </file>
        <!-- Windows 脚本：dos 换行 -->
        <file>
            <source>src/main/assembly/bin/startup.cmd</source>
            <outputDirectory>bin</outputDirectory>
            <lineEnding>dos</lineEnding>
            <fileMode>0755</fileMode>
        </file>
    </files>

    <fileSets>
        <!-- 外置配置：从 admin 的 resources 取 yml/properties 到 conf/ -->
        <fileSet>
            <directory>${project.parent.basedir}/apigrab-admin/src/main/resources</directory>
            <outputDirectory>conf</outputDirectory>
            <includes>
                <include>*.yml</include>
                <include>*.properties</include>
            </includes>
            <lineEnding>unix</lineEnding>
            <fileMode>0644</fileMode>
        </fileSet>

        <!-- 运行依赖：admin 普通 jar + 全部依赖 jar（由 copy-dependencies 拷到 admin/target） -->
        <fileSet>
            <directory>${project.parent.basedir}/apigrab-admin/target</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>

        <!-- 创建空的 logs 目录 -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>logs</outputDirectory>
            <excludes>
                <exclude>**/*</exclude>
            </excludes>
        </fileSet>
    </fileSets>
</assembly>
